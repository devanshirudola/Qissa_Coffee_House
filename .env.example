# Backend
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/qissa_coffee_house
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_NAME=Qissa Administrator
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_private_12_character_or_longer_password
# Set true only when deliberately promoting an existing customer account
ADMIN_PROMOTE_EXISTING=false
BUSINESS_TIME_ZONE=Asia/Kolkata
RESERVATION_OPEN_TIME=09:00
RESERVATION_CLOSE_TIME=21:00
RESERVATION_SLOT_INTERVAL_MINUTES=30
RESERVATION_SLOT_CAPACITY=12

# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_API_URL=http://localhost:5000/api\n
